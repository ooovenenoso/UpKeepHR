{
  "name": "upkeephr",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "prisma generate && tsx scripts/migrate-cloud.ts && tsx scripts/seed.ts",
    "dev": "concurrently -k -n WEB,MOTOR \"next dev --hostname 127.0.0.1\" \"tsx scripts/worker.ts\"",
    "local": "npm run setup && npm run dev",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:http": "tsx scripts/smoke-cloud.ts",
    "backup": "tsx scripts/backup.ts",
    "init-admin": "npm run bootstrap",
    "start:local": "concurrently -k -n WEB,MOTOR \"next start --hostname 127.0.0.1\" \"tsx scripts/worker.ts\"",
    "provision": "tsx scripts/provision.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "migrate": "tsx scripts/migrate-cloud.ts",
    "restore:test": "tsx scripts/restore-test.ts",
    "deploy": "tsx scripts/deploy.ts",
    "clear:employees": "tsx scripts/clear-employees.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "2.95.3",
    "better-auth": "1.7.7",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-qr-code": "2.0.18",
    "resend": "^6.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
