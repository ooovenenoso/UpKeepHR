APP_MODE=local
APP_URL=http://127.0.0.1:3000
DATA_PROFILE=test
DATABASE_SCHEMA=hhrr_test
DATABASE_URL=postgresql://hhrr_test_runner.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_PLACEHOLDER
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_SECRET=REPLACE_WITH_THE_SAME_SECRET
CRON_SECRET=REPLACE_WITH_A_RANDOM_SECRET
EMAIL_ENABLED=false
EMAIL_PROVIDER=disabled
# Production: APP_MODE=cloud, DATA_PROFILE=production, DATABASE_SCHEMA=public.
# Secrets live outside the repository. Never include tokens in this file.
# Provisioning reads these from the private administrative configuration:
# SUPABASE_PROJECT_REF=PROJECT_REF
# VERCEL_TEAM_ID=YOUR_TEAM_ID
# VERCEL_PROJECT_NAME=upkeephr
# GITHUB_REPOSITORY=YOUR_OWNER/upkeephr
# PRODUCTION_APP_URL=https://YOUR_PROJECT.vercel.app
# UPKEEPHR_CONFIG_DIR=ABSOLUTE_PRIVATE_CONFIG_DIRECTORY
